{
  "headers": [
    {
      "source": "/faces/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "functions": {
    "api/[[...route]].ts": {
      "maxDuration": 30,
      "includeFiles": "src/**"
    }
  }
}
